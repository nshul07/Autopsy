<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Automated scanning: SMS receiver + email-notification reader.
         Both are user-granted; the app has no INTERNET permission and
         analysis never leaves the device. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to hand a clean link back to a real browser. API 30+ hides
         other installed packages from us without this, and the failure mode
         is silent: queryIntentActivities returns only ourselves, so the
         "which browser should I use?" picker looks empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".AppAutopsyApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="AppAutopsy"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppAutopsy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="AppAutopsy">
            <!-- CATEGORY_APP_BROWSER is what makes Android offer AppAutopsy in
                 Settings → Default apps → Browser, and BROWSABLE is what makes
                 it eligible to hold the browser role at all. Both are REQUIRED
                 for RoleManager.createRequestRoleIntent(ROLE_BROWSER) to
                 resolve; without them the request fails silently and this app
                 never sees a tapped link — which is exactly why link
                 interception appeared to do nothing. The role is not optional
                 for the product promise: Android sends ACTION_VIEW to the
                 default browser and nobody else, so "check every link I tap"
                 is only possible from inside the browser role. Clean links are
                 handed straight back to the user's real browser (see
                 LinkHandoff), so holding the role does not trap anyone here. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>

            <!-- Real-time: appear in "Open with" for every web link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- And in the share sheet for text (chats, emails). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- And in the text-selection menu of ANY app (select a link in
                 an Instagram DM or a Facebook post → "AppAutopsy"). This is
                 the only door into apps whose in-app WebView cannot be
                 intercepted and whose share sheet is not offered. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".watch.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- The "Open anyway" action on a held-link warning. Not exported:
             only our own PendingIntent may trigger it, so no other app can
             make this device open a URL of its choosing. -->
        <receiver
            android:name=".watch.HandoffReceiver"
            android:exported="false" />

        <service
            android:name=".watch.MailNotificationListener"
            android:exported="false"
            android:label="AppAutopsy mail scan"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
