# Copy to .env and fill in. NEVER commit .env.
# Every key here is OPTIONAL. A missing key means that check returns
# "not_checked" with 0 points. The app must never crash because a key is absent.

# --- Core ---
MAX_APK_MB=100
REPORT_TTL_SECONDS=3600
REPORT_STORE_MAX_ENTRIES=500
CORS_ORIGINS=http://localhost:5173

# --- Zip-bomb guards (do not raise these without a reason) ---
ZIP_MAX_MEMBER_MB=10
ZIP_MAX_TOTAL_MB=50
ZIP_MAX_ENTRIES=2000

# --- Reputation providers (all optional) ---
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# --- Intel store ---
INTEL_DB_PATH=intel.db

# --- WhatsApp Guardian bot (optional; F17) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Feature flags ---
# Both must stay false for v1. See AGENTS.md section 2.3 (no ML in the scoring path).
ENABLE_LLM_CATEGORY_HINT=false
ENABLE_DEX_STRINGS=false