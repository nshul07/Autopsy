# Secrets — never commit
.env
.env.local
*.key
*.pem

# Uploaded / analyzed artifacts — must never be committed
*.apk
*.xapk
*.dex
*.jar
demo/android-demo-apps/build/
demo/recording/*.mp4

# Intel database (aggregate counts, rebuilt locally)
intel.db
intel.db-wal
intel.db-shm

# Benchmark scratch — the corpus and sweep output are large and regenerable.
# The harness itself (tools/bench_phishing.py) IS committed; only its data is not.
.bench/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Android / Gradle
local.properties
.gradle/
build/
captures/
.cxx/
*.iml
*.hprof

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/